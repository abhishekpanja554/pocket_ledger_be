{
  "family": "pocket-ledger-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::567627324227:role/pocket-ledger-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::567627324227:role/pocket-ledger-task-role",
  "containerDefinitions": [
    {
      "name": "pocket-ledger-be",
      "image": "567627324227.dkr.ecr.ap-south-1.amazonaws.com/pocket-ledger-be:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "DB_URL", "value": "jdbc:postgresql://pocket-ledger-db.ctiwcsww0gwr.ap-south-1.rds.amazonaws.com:5432/pocket_ledger" },
        { "name": "DB_USER", "value": "postgres" },
        { "name": "S3_BUCKET", "value": "pocket-ledger-s3-567627324227-ap-south-1-an" },
        { "name": "AWS_REGION", "value": "ap-south-1" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-south-1:567627324227:secret:rds!db-b8e3155e-93fe-4493-bcc3-c88b876474ff-lxBoSh:password::" },
        { "name": "GOOGLE_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:567627324227:secret:pocket-ledger/google-api-key-xlvnIQ:GOOGLE_API_KEY::" },
        { "name": "GOOGLE_CREDENTIALS_JSON", "valueFrom": "arn:aws:secretsmanager:ap-south-1:567627324227:secret:pocket-ledger/google-credentials-json-pRVQUG:GOOGLE_CREDENTIALS_JSON::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pocket-ledger-be",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  }
}